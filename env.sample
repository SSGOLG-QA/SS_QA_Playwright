# ── 경기관제 어드민(td17) QA 자동 로그인 환경변수 템플릿 ──────────────
#  사용법: 이 파일을 `.env` 로 복사한 뒤 실제 테스트 계정 값을 채우세요.
#          `.env` 는 .gitignore 로 커밋 차단됨(자격증명은 절대 커밋 금지).
#          playwright.config.ts 가 dotenv 로 자동 로드합니다.
#
#  동작: SS_USERNAME / SS_PASSWORD 가 모두 있으면 `npm run auth` 가
#        수동 로그인 대신 폼 자동 입력으로 세션(storageState)을 생성합니다.
#        (로그인 폼: 클럽 검색 → ID → PW → [로그인], 2FA/CAPTCHA 없음)
# ──────────────────────────────────────────────────────────────────────

SS_USERNAME=테스트계정_아이디
SS_PASSWORD=테스트계정_비밀번호

# ── 선택 설정 ───────────────────────────────────────────────
# 대상 서브도메인/클럽 (기본값: td17 / 킹즈락). 대회모드 검증은 td18.
# SUBDOMAIN=td17
# CLUB_NAME=킹즈락

# 자동 로그인을 끄고 수동(headed) 로그인으로 되돌리려면:
# AUTO_LOGIN=0

# 병렬 계정 풀(N개) 자동 로그인 시 — 계정별로 SS_USERNAME_2 등은 미지원.
# 계정 풀은 현재 수동 로그인 전제(ACCOUNT_COUNT). 단일 계정 자동 로그인이 기본.
